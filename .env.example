# 초기 MVP는 환경변수 없이도 빌드됩니다.
# Netlify 자동 분석을 활성화하려면 OPENAI_API_KEY를 설정하세요.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 선택: 수동 실행 API 보호용
MARKET_WATCH_RUN_SECRET=
MARKET_WATCH_BLOB_STORE=daily-market-watch

# 선택: 네이버 뉴스 API가 있으면 우선 사용, 없으면 Google News RSS/mock fallback 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 후속 공공 API placeholder
# 초기 Netlify 안정 배포형 MVP는 환경변수 없이도 빌드/실행됩니다.
# 아래 값들은 후속 단계에서 AI·공공 API·DB 연동 시 사용할 placeholder입니다.

OPENAI_API_KEY=
DATA_GO_KR_SERVICE_KEY=
NEIS_API_KEY=
CHILDCARE_API_KEY=
KOSIS_API_KEY=
KIPRIS_API_KEY=
NTS_BUSINESS_API_KEY=
OPENDART_API_KEY=
